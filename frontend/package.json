{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "test": "playwright test",
    "test:logout": "playwright test --config playwright.logout.config.js",
    "test:pwa": "npm run build && playwright test --config playwright.pwa.config.js",
    "test:sprint45": "playwright test --config playwright.sprint45.config.js",
    "test:system-admin": "playwright test --config playwright.system-admin.config.js",
    "test:real-regression": "playwright test --config playwright.real-regression.config.js",
    "test:ui-regression": "playwright test --config playwright.ui-regression.config.js",
    "test:worker-dev": "playwright test --config playwright.worker-dev.config.js",
    "test:unit": "node --test tests/gantt-unit.test.mjs tests/schedule-view-model.test.mjs tests/project-calendar.test.mjs tests/journal-identity.test.mjs tests/finance-view-model.test.mjs",
    "test:t31": "playwright test --config playwright.t31.config.js",
    "test:t31:serve": "node tests/fixtures/gantt-server.mjs",
    "test:preview": "playwright test --config playwright.preview.config.js",
    "preview": "vite preview",
    "test:sprint68": "playwright test --config playwright.sprint68.config.js",
    "test:unified-shell": "playwright test --config playwright.unified-shell.config.js"
  },
  "dependencies": {
    "antd": "^6.6.5",
    "axios": "^1.20.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "overrides": {
    "source-map-js": "1.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "vite": "^8.3.0"
  }
}
