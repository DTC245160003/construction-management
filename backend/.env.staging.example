# Placeholder values only. Configure a separate staging database before deployment.
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=construction_management_staging
DB_USER=construction_staging
DB_PASSWORD=replace_with_staging_password
SESSION_SECRET=replace_with_random_secret_at_least_32_bytes
SESSION_COOKIE_SECURE=true
TRUST_PROXY=1
APP_URL=https://replace-with-staging-host.example

# Vietnamese PDF font (installed in the backend Docker image).
PDF_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
PHOTO_MAX_CAPTURE_AGE_DAYS=7
PHOTO_FUTURE_TOLERANCE_HOURS=24
HEALTH_DATABASE_TIMEOUT_MS=2000
