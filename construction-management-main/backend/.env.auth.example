# Add these settings to your existing backend/.env; keep your DB_* settings.
# Generate SESSION_SECRET with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# false for local HTTP; true for staging/production served over HTTPS.
SESSION_COOKIE_SECURE=false
# Set to 1 only when running behind one trusted reverse proxy.
TRUST_PROXY=0
