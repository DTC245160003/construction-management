# Optional email delivery. In-app notifications work without SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
APP_URL=http://localhost:5173

# Vietnamese-capable TTF/OTF font for PDF export. Common Windows/Linux fonts
# are detected automatically; set this path when deploying on another host.
PDF_FONT_PATH=
