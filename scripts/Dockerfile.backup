FROM postgres:17-alpine

RUN apk add --no-cache tzdata

COPY scripts/backup-staging.sh scripts/restore-staging.sh scripts/backup-scheduler.sh /usr/local/bin/
RUN chmod 0555 /usr/local/bin/backup-staging.sh \
    /usr/local/bin/restore-staging.sh \
    /usr/local/bin/backup-scheduler.sh

ENTRYPOINT []
CMD ["/usr/local/bin/backup-scheduler.sh"]
